{
  "ci": {
    "collect": {
      "startServerCommand": "node scripts/serve.js 3250",
      "startServerReadyPattern": "Serveur statique prêt",
      "url": [
        "http://localhost:3250/",
        "http://localhost:3250/catalogue",
        "http://localhost:3250/taches",
        "http://localhost:3250/contact",
        "http://localhost:3250/catalogue/plantes-interieur",
        "http://localhost:3250/catalogue/plantes-interieur/feuillages",
        "http://localhost:3250/mentions-legales",
        "http://localhost:3250/donnees-personnelles",
        "http://localhost:3250/accessibilite",
        "http://localhost:3250/plan-du-site"
      ],
      "numberOfRuns": 1,
      "settings": {
        "chromeFlags": "--headless=new --no-sandbox"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 1
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 1
          }
        ],
        "categories:best-practices": [
          "warn",
          {
            "minScore": 0.9
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci/reports"
    }
  }
}
